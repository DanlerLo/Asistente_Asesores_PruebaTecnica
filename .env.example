# Copia este archivo a .env y ajusta lo que necesites. Todos los valores tienen un defecto local.

# Base documental y persistencia
DATA_DIR=./Data
DB_PATH=./storage/consultas.db
ARCHIVOS_RESTRINGIDOS=Información restringida.md

# Límites y recuperación
MAX_LONGITUD_PREGUNTA=1000
TOP_K=8
UMBRAL_COBERTURA=0.3

# CORS (separar con ;)
CORS_ORIGENES=http://localhost:5173;http://127.0.0.1:5173

# Recuperación semántica: local (por defecto; embeddings en CPU, el modelo se descarga solo la primera vez) | none
EMBEDDINGS=local
EMBEDDINGS_MODELO=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDINGS_CACHE=./storage/modelos
UMBRAL_SEMANTICO=0.6

# LLM opcional: none (por defecto, 100 % local) | groq. Sin clave o con otro valor, arranca sin conexión.
# groq: gratuito (https://console.groq.com/keys). Modelo por defecto: openai/gpt-oss-20b
# Clave de evaluación: pídanmela a loaizad65@gmail.com (ver README, sección Configuración).
LLM_PROVIDER=none
LLM_MODEL=
GROQ_API_KEY=
LLM_TIMEOUT_SEGUNDOS=30
LLM_MAX_FRAGMENTOS=12

LOG_LEVEL=INFO
